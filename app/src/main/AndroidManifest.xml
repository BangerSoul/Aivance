<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Model download runs as a foreground service (dataSync). On Android 14+
         the foregroundServiceType MUST be declared on the service element, and
         the FOREGROUND_SERVICE_* permissions are required — otherwise the work
         crashes with "foregroundServiceType 0x1 not a subset of 0x0" (QA E2E
         2026-08-11: Continue on Gemma onboarding crashed the app). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <!-- AppLinkUrlError is suppressed: these are intentional in-app deep links
         using the custom aivance:// scheme, not Android App Links (which require
         an https scheme + verified web domain). -->
    <application
        android:name=".AivanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aivance"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="AppLinkUrlError">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aivance"
            android:windowSoftInputMode="adjustResize">

            <!-- Launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link: job details -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aivance"
                    android:host="jobs"
                    android:pathPrefix="/" />
            </intent-filter>

            <!-- Deep Link: AI chat conversations -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aivance"
                    android:host="chat"
                    android:pathPrefix="/" />
            </intent-filter>

            <!-- Deep Link: interview sessions -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aivance"
                    android:host="interview"
                    android:pathPrefix="/" />
            </intent-filter>

            <!-- Deep Link: resume details -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aivance"
                    android:host="resume"
                    android:pathPrefix="/" />
            </intent-filter>

            <!-- Deep Link: generic app open -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="aivance"
                    android:host="app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager's SystemForegroundService must declare the type used by
             GemmaModelDownloadWorker (dataSync) or the model-download work
             crashes the app on Android 14+ (QA E2E 2026-08-11). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
