{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uesf.dev/spec/skill-spec.schema.json",
  "title": "UESF Skill Specification v1.0.0 — frontmatter schema",
  "description": "Machine-readable contract for the frontmatter of every UESF SKILL.md. Enforced by tools/validate_framework.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "version", "category", "kind", "purpose", "description",
    "triggers", "inputs", "outputs", "dependencies", "context_requirements",
    "quality_gates", "validation", "rollback", "failure_recovery",
    "acceptance_criteria", "automation_hooks", "mcp_tools", "cost",
    "complexity", "maintainability_score", "scalability_score",
    "production_readiness", "related_skills"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^uesf-[a-z]{2}-[a-z0-9-]+$",
      "description": "Stable identifier: uesf-<category-code>-<slug>. Never changes after publish."
    },
    "name": { "type": "string", "minLength": 3 },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of the skill document itself."
    },
    "category": {
      "type": "string",
      "enum": ["co","pl","ar","ra","im","te","dg","rf","pf","se","ax","do","re","de","cl","ai","pe","ux","ui","da","nw","au","rs","ce","pm","gv","le","mk","km","ac","ex"],
      "description": "Primary category code. See docs/taxonomy.md."
    },
    "kind": {
      "type": "string",
      "enum": ["core","engineering","ai","ux","ui","meta","example"]
    },
    "purpose": { "type": "string", "minLength": 10 },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024,
      "description": "Discovery-optimized: describes WHEN to use, not the workflow. <1024 chars."
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "condition": { "type": "string" },
              "example_prompt": { "type": "string" }
            }
          }
        ]
      }
    },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "context_requirements": { "type": "array", "items": { "type": "string" } },
    "quality_gates": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Verification strategies: unit, integration, regression, performance, security, accessibility, documentation, certification."
    },
    "rollback": { "type": "string", "minLength": 10 },
    "failure_recovery": { "type": "string", "minLength": 10 },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "automation_hooks": { "type": "array", "items": { "type": "string" } },
    "mcp_tools": { "type": "array", "items": { "type": "string" } },
    "cost": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "string" },
        "output_tokens": { "type": "string" },
        "runtime_minutes": { "type": "string" }
      },
      "required": ["input_tokens", "output_tokens", "runtime_minutes"]
    },
    "complexity": { "type": "integer", "minimum": 1, "maximum": 5 },
    "maintainability_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "scalability_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "production_readiness": { "type": "integer", "minimum": 1, "maximum": 5 },
    "related_skills": { "type": "array", "items": { "type": "string" } },
    "documentation": { "type": "string" },
    "deprecated": { "type": "boolean", "default": false },
    "superseded_by": { "type": "string" }
  }
}
